{
  "expo": {
    "name": "curonn",
    "slug": "curonn",
    "icon": "./assets/curonn_appicon.png",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "curonn",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.curonn.health",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Curonn uses your location to find healthcare services near you. For example, your location helps us show nearby diagnostic centers, hospitals, doctors, and pharmacies when you search or book a healthcare service."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/curonn_appicon.png",
        "backgroundColor": "#D94A2C"
      },
      "package": "com.curonn.health",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBrbqkkwpKdU0qIOkmJm6JnULSDr729oic"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "androidStatusBar": {
      "backgroundColor": "#D94A2C",
      "barStyle": "dark-content"
    },
    "plugins": [
      "expo-router",
      "expo-maps",
      "expo-font",
      "expo-secure-store",
      [ 
        "expo-image-picker",
        {
          "photosPermission": "Curonn Health accesses your photos so you can select and upload medical documents, prescriptions, and images to your healthcare provider.",
          "cameraPermission": "Curonn Health uses your camera to capture medical documents, prescriptions, and images that you choose to upload to your healthcare provider."
        }
      ],
      "expo-document-picker",
      "expo-file-system",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Curonn uses your location to find healthcare services near you. For example, your location helps us show nearby diagnostic centers, hospitals, doctors, and pharmacies when you search or book a healthcare service."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D94A2C",
          "image": "./assets/Splash_Screen.png",
          "resizeMode": "contain",
          "statusBarTranslucent": true,
          "statusBarHidden": true,
          "statusBarStyle": "light",
          "statusBarBackgroundColor": "#D94A2C",
          "statusBarVisible": false,
          "width": 375,
          "height": 375
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b083a89-1b5f-4be4-893a-7c64ee3efde0"
      }
    },
    "owner": "janardhanreddy"
  }
}